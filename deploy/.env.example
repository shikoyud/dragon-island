# Variables docker compose substitutes into docker-compose.yml. Copy to deploy/.env, fill in,
# `chmod 600`. Never commit the filled-in file.

# Public game hostname; Caddy gets its TLS certificate for this name.
PLAY_DOMAIN=play.example.com
# Postgres superuser password for the `dragon` role. URL-safe (`openssl rand -hex 32`), and the
# same value as the password inside DATABASE_URL in deploy/.env.server.
POSTGRES_PASSWORD=CHANGE_ME
