# Settings for backup.sh and restore-drill.sh. Copy to deploy/backup.env (not committed).
# Sourced as bash. No secrets here: R2 credentials live in rclone's config, and the age
# identity (private key) is only referenced by path.

# age PUBLIC key that dumps are encrypted to (from `age-keygen -y <identity file>`).
BACKUP_AGE_RECIPIENT=age1replacewithyourpublickey
# rclone remote (an R2 "s3" remote set up with `rclone config`) and bucket/path.
BACKUP_RCLONE_REMOTE=r2:dragon-island-backups
# Path to the age identity file used by the restore drill. chmod 600, owned by the cron user.
# Keep an offline copy too: without it no backup can ever be decrypted.
BACKUP_AGE_IDENTITY=/root/.config/dragon-island/backup-age.key
# Retention (counts of files kept).
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
# Optional heartbeat URL fetched after each successful backup (e.g. an UptimeRobot heartbeat monitor).
# BACKUP_HEARTBEAT_URL=
