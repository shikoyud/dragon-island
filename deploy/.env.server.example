# Dragon Island game server environment (read by the `server` service in docker-compose.yml).
# Copy to deploy/.env.server, fill in, `chmod 600`. NEVER commit the filled-in file: it holds
# the signer and operator keys, the admin token and webhook URLs. Placeholders only below.
# Every key is validated by apps/server/src/config.ts at startup.

NODE_ENV=production

# --- HTTP ---
# Port inside the container; Caddy proxies /api/* here. Leave at 3000.
PORT=3000
# Behind Caddy (and Cloudflare): take the client IP from X-Forwarded-For. Caddy overwrites that
# header with the single real client IP, so rate limits and referral checks see real players.
TRUST_PROXY=true

# --- Database ---
# The compose `postgres` service. The password MUST equal POSTGRES_PASSWORD in deploy/.env;
# use a URL-safe value (e.g. `openssl rand -hex 32`).
DATABASE_URL=postgres://dragon:CHANGE_ME_SAME_AS_POSTGRES_PASSWORD@postgres:5432/dragon
# Only used when DATABASE_URL is empty (local PGlite). Unused in production.
PGLITE_DIR=./.pglite

# --- Sessions and sign-in ---
# At least 32 random characters (`openssl rand -hex 32`). Also salts the sign-in origin hashes;
# rotating it logs everyone out and resets referral overlap checks.
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
# Session lifetime in ms (default 7 days).
SESSION_TTL_MS=604800000
# SIWE: the host and origin players sign in from, i.e. the public game URL.
SIWE_DOMAIN=play.example.com
SIWE_URI=https://play.example.com
# Closed beta: only allowlisted wallets may sign in. Takes effect once the closed-beta
# allowlist ships (Task 5); until then the server ignores it.
BETA_CLOSED=true

# --- Chain (Robinhood Chain TESTNET only; the server refuses any other chain id) ---
CHAIN_ID=46630
# RPC endpoint. If your provider URL embeds an API key, treat this line as a secret: the URL can
# show up in server logs and Sentry error text.
RPC_URL=https://rpc.testnet.chain.robinhood.com
# Deployed DrisVault and DrisToken addresses (0x + 40 hex). Leave unset until deployed.
# VAULT_ADDRESS=0x0000000000000000000000000000000000000000
# TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# EIP-712 voucher signer key (0x + 64 hex). SECRET. Must match the vault's signer role.
# SIGNER_PRIVATE_KEY=0x...
# Operator key for burnBatch (0x + 64 hex). SECRET. Must match the vault's operator role.
# OPERATOR_PRIVATE_KEY=0x...
# Blocks to wait before the indexer trusts an event.
CONFIRMATIONS=1
# The vault's deployment block (first block the indexer scans) and the getLogs range per call.
INDEXER_START_BLOCK=0
INDEXER_CHUNK=2000

# --- Operations ---
# x-admin-token for /admin/*. At least 32 random characters; compared in constant time. SECRET.
ADMIN_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
# Discord webhook for chain-watch alerts (alerts are only logged when unset). SECRET.
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Sentry DSN for server errors; the SDK only loads when set.
# SENTRY_DSN=https://...@....ingest.sentry.io/...
# Content catalog; only `launch` exists.
CATALOG=launch
# Playwright test mode. MUST stay 0 in production (it hands out free tokens; the server refuses
# E2E=1 together with NODE_ENV=production or a DATABASE_URL).
E2E=0
