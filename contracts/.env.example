# Copy to .env (git-ignored) and fill in. Never put a private key here: deploy with `--account <keystore>`.
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com   # verify at docs.robinhood.com/chain

# Roles (testnet addresses)
OWNER_SAFE=0x0000000000000000000000000000000000000000        # 2-of-3 Safe; becomes vault owner after acceptOwnership()
TREASURY=0x0000000000000000000000000000000000000000          # receives entry-fee ETH (funds the buyback)
OPERATOR=0x0000000000000000000000000000000000000000          # server key: burn batches, entry fee price, pause
SIGNER=0x0000000000000000000000000000000000000000            # server voucher-signing key (holds no funds)
LAUNCH_RECIPIENT=0x0000000000000000000000000000000000000000  # receives the 50% fair-launch allocation

# Parameters
ENTRY_FEE_WEI=500000000000000             # ~$1 of ETH at deploy time; the operator keeps it current
BURN_DAILY_LIMIT=1000000000000000000000000  # 1,000,000 WYRM per UTC day
# ALLOW_CHAIN_ID=46630                    # only change for a local anvil dry run (31337)
