# Copy to .env (git-ignored). Never commit real keys.
PORT=3000
# Postgres in production; leave unset to run on a file-backed PGlite (dev only).
# DATABASE_URL=postgres://user:pass@localhost:5432/wyrmhaven
PGLITE_DIR=./.pglite

SESSION_SECRET=change-me-to-32-plus-random-characters
SESSION_TTL_MS=604800000
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:5173

# Robinhood Chain testnet only (verify values at docs.robinhood.com/chain)
CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com
VAULT_ADDRESS=            # from the Phase 3 deployment; without it the server uses an in-memory fake chain
TOKEN_ADDRESS=
SIGNER_PRIVATE_KEY=       # voucher signer (must match vault.signer()); withdrawals are disabled without it
OPERATOR_PRIVATE_KEY=     # burn batches; optional
CONFIRMATIONS=1
INDEXER_START_BLOCK=0       # the vault's deployment block
INDEXER_CHUNK=2000          # max blocks per getLogs call (public RPCs cap the range)

ADMIN_TOKEN=change-me-to-at-least-32-random-characters
CATALOG=launch
