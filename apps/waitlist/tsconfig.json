{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "types": ["node"],
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "src", "test", "drizzle.config.ts", "next.config.ts", "vitest.config.ts", "playwright.config.ts", "e2e", "scripts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
